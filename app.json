{
  "expo": {
    "name": "Agentic OS",
    "slug": "agentic-os",
    "version": "4.1.0",
    "orientation": "default",
    "icon": "./assets/images/app-icon-light.png",
    "scheme": "agenticos",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.norrita.agenticos",
      "buildNumber": "100",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/app-icon-light.png",
        "dark": "./assets/images/app-icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Agentic OS connects straight to your PC on this Wi-Fi so the trackpad has no lag.",
        "NSCameraUsageDescription": "Agentic OS uses the camera when you turn your phone into your PC's webcam.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSAlarmKitUsageDescription": "Agentic OS rings the alarms you set, and the ones your PC sets for you, even when the phone is on silent.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "aps-environment": "production",
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.norrita.agenticos",
          "$(AppIdentifierPrefix)com.norrita.agenticos.shared"
        ]
      }
    },
    "android": {
      "package": "com.norrita.agenticos",
      "adaptiveIcon": {
        "backgroundColor": "#357DCE",
        "foregroundImage": "./assets/images/app-icon-light.png",
        "backgroundImage": "./assets/images/app-icon-light.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./modules/alarms/app.plugin.js",
      [
        "./modules/app-icon/app.plugin.js",
        {
          "icons": {
            "AppIconLight": "./assets/images/app-icon-light.png",
            "AppIconDark": "./assets/images/app-icon-dark.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Agentic OS uses the microphone for your calls with Nora, and when you hold the mic in GPT mode to dictate on your PC.",
          "recordAudioAndroid": false,
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Agentic OS sends the photos and videos you pick to your PC.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
