{
  "expo": {
    "name": "Agentic OS",
    "slug": "agentic-os",
    "version": "4.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agenticos",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.norrita.agenticos",
      "buildNumber": "100",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Agentic OS connects straight to your PC on this Wi-Fi so the trackpad has no lag.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.norrita.agenticos",
          "$(AppIdentifierPrefix)com.norrita.agenticos.shared"
        ]
      }
    },
    "android": {
      "package": "com.norrita.agenticos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@bacons/apple-targets",
      [
        "expo-audio",
        {
          "microphonePermission": "Agentic OS uses the microphone when you hold the mic in GPT mode, to dictate on your PC.",
          "recordAudioAndroid": false,
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Agentic OS sends the photos and videos you pick to your PC.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
